# =============================================================================
# .env — DÉVELOPPEMENT LOCAL UNIQUEMENT
# Ne jamais commiter ce fichier (vérifie qu'il est bien dans .gitignore).
# Les vraies valeurs de production vont dans le dashboard Render, pas ici.
# =============================================================================

# --- Base de données ---
DB_NAME=parc_auto_db
DB_USER=parc_auto_user
DB_PASSWORD=parc_auto?passwd
DB_HOST=localhost
DB_PORT=5432

DB_EXPORTER_USER=postgres_exporter
DB_EXPORTER_PASSWORD=change_moi_en_dur

# --- Django ---
# Générée aléatoirement pour ton usage local. Render génère automatiquement
# une clé différente en production (generateValue: true dans render.yaml) —
# ne réutilise jamais la même clé entre local et prod.
DJANGO_SECRET_KEY=069E+__vg^Bk+j_=c-Zufm#f(C9$!z(T1Cv9X4i-137HvXB8nO
DEBUG=True

# Ces 3 variables sont volontairement ABSENTES ici (pas juste vides) : quand
# une clé n'existe pas du tout dans le .env, decouple applique la valeur par
# défaut définie dans settings.py (127.0.0.1, localhost, etc. pour
# ALLOWED_HOSTS). Si tu les écris avec une valeur vide (ex: ALLOWED_HOSTS=),
# decouple renvoie cette chaîne vide au lieu du défaut, et ALLOWED_HOSTS
# devient une liste vide qui bloque TOUTES les requêtes, y compris en local.
#
# ALLOWED_HOSTS=          <- ne décommente pas, laisse la variable absente
# CORS_ALLOWED_ORIGINS=   <- idem
# CSRF_TRUSTED_ORIGINS=   <- idem (celle-ci n'a pas besoin de défaut particulier en local)

# --- Cloudflare R2 (stockage des photos) ---
# Optionnel en local si tu n'as pas encore créé le bucket : le champ
# AWS_ACCESS_KEY_ID etc. auront simplement une valeur vide (default='' dans
# settings.py), et l'upload de photo échouera juste si tu testes cette
# fonctionnalité précise en local. Renseigne ces 3 valeurs pour tester R2
# depuis ta machine avant de déployer.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=convoy-media
R2_ENDPOINT_URL=